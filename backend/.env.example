# ============================================================
# ENVIRONMENT VARIABLES — Mexico Trip Planner Backend
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de Datos (Aiven PostgreSQL) ─────────────────────────
# Opción A: Connection string completo (recomendado para Aiven)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# Opción B: Variables individuales (comentar si usas DATABASE_URL)
# DB_HOST=your-aiven-host.aivencloud.com
# DB_PORT=5432
# DB_USER=avnadmin
# DB_PASSWORD=your_password
# DB_NAME=defaultdb
# DB_SSL=true

# ── Google Maps ───────────────────────────────────────────────
# Habilitar en Google Cloud Console:
#   - Distance Matrix API
#   - Directions API
#   - Places API
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ── CORS ─────────────────────────────────────────────────────
# URLs permitidas separadas por coma
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3001

# ── Configuración de Proximidad (fallback si Trip no tiene valor) ──
# Este valor se usa solo si el campo proximityThresholdKm del Trip es nulo
DEFAULT_PROXIMITY_THRESHOLD_KM=5
